{
  "schemaVersion": 1,
  "id": "vanillabackport",
  "version": "${version}",
  "name": "VanillaBackport",
  "description": "Backporting Minecraft Features to previous versions!",
  "authors": [
    "BlackGear"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/vanillabackport",
    "sources": "https://github.com/ItsBlackGear/VanillaBackport",
    "issues": "https://github.com/ItsBlackGear/VanillaBackport/issues"
  },
  "license": "https://github.com/ItsBlackGear/VanillaBackport/blob/1.20.1/LICENSE.txt",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "com.blackgear.vanillabackport.core.fabric.emissive.EmissiveModelHandler",
      "com.evandev.tiny_takeover_backport.client.TinyTakeoverBackportClient"
    ],
    "main": [
      "com.blackgear.vanillabackport.core.fabric.VanillaBackportFabric",
      "com.evandev.tiny_takeover_backport.TinyTakeoverBackportFabric",
      "com.blackgear.vanillabackport.core.fabric.IceCavesCreativeSorting"
    ],
    "fabric-datagen": [
      "com.blackgear.vanillabackport.data.DataGenerator"
    ],
    "terrablender": [
      "com.blackgear.vanillabackport.core.fabric.VanillaBackportTerrablender"
    ],
    "jei_mod_plugin": [
      "com.blackgear.vanillabackport.core.compat.VanillaBackportJeiPlugin"
    ]
  },
  "mixins": [
    "vanillabackport.mixins.json",
    "vanillabackport-tiny.mixins.json",
    "vanillabackport-tiny-armor.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.12",
    "platform": ">=1.4.2",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  },
  "custom": {
    "badoptimizations:cache_hooks": {
      "common": "com.blackgear.vanillabackport.client.api.modules.end_flashes.BadOptimizationsCommonHook"
    }
  }
}
